# =============================================================================
# ALLBARKA ISOLATED PREVIEW / TEST ENVIRONMENT CONFIGURATION
# =============================================================================
# CAUTION: Never point this file to production ('allbarka-live').
# All live mutation tests, test product creations, and test staff grants must
# target an isolated preview/staging Firebase project (e.g. 'allbarka-preview').
# =============================================================================

# Isolated Preview Firebase Web Configuration
VITE_FIREBASE_PROJECT_ID=allbarka-preview
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=allbarka-preview.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=allbarka-preview.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIRESTORE_DATABASE_ID=(default)

# Preview Express API Base URL (if frontend runs on a separate preview port/origin)
VITE_API_BASE_URL=

# Server Environment & Port
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
FRONTEND_ORIGINS=http://localhost:3001,http://localhost:5173
TRUST_PROXY_HOPS=0

# Firebase Admin SDK (Isolated Preview Service Account)
FIREBASE_PROJECT_ID=allbarka-preview
FIREBASE_CLIENT_EMAIL=preview-admin-sa@allbarka-preview.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=
FIRESTORE_DATABASE_ID=(default)

# Dedicated Test User Identities (Must be provisioned in preview Auth with verified emails)
TEST_ADMIN_UID=preview-admin-uid
TEST_ADMIN_EMAIL=preview-admin@allbarka.test
TEST_STAFF_UID=preview-staff-uid
TEST_STAFF_EMAIL=preview-staff@allbarka.test
TEST_CUSTOMER_UID=preview-customer-uid
TEST_CUSTOMER_EMAIL=preview-customer@allbarka.test

# Isolated Preview Storage Bucket
STORAGE_BUCKET=allbarka-preview.firebasestorage.app

# Private Integrations (Disabled or pointing to preview webhook receivers)
N8N_AI_WEBHOOK_URL=
N8N_AI_WEBHOOK_SECRET=
N8N_ORDER_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_INTEGRATION_SECRET=
WHATSAPP_PARENT_VERIFIED=false
