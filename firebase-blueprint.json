{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Patron profile and address details",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "tier": { "type": "string" },
        "loyaltyPoints": { "type": "number" }
      }
    },
    "ActiveReward": {
      "title": "ActiveReward",
      "description": "User active discount or reward coupon",
      "type": "object",
      "properties": {
        "rewardId": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string", "enum": ["ACTIVE", "USED", "EXPIRED"] },
        "code": { "type": "string" },
        "claimedAt": { "type": "number" }
      }
    },
    "LoyaltyTransaction": {
      "title": "LoyaltyTransaction",
      "description": "Record of earned or spent points",
      "type": "object",
      "properties": {
        "points": { "type": "number" },
        "type": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "number" }
      }
    },
    "Order": {
      "title": "Order",
      "description": "Placed order details",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "uid": { "type": "string" },
        "status": { "type": "string" },
        "total": { "type": "number" }
      }
    },
    "InquiryQuote": {
      "title": "InquiryQuote",
      "description": "Unified customer inquiry, wholesale request, custom hamper, and Bid Box bargain quote record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["bid_box_quote", "wholesale", "custom_hamper", "general"] },
        "customerName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "city": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "boxMode": { "type": "string", "enum": ["empty", "filled"] },
        "quantity": { "type": "number" },
        "eventType": { "type": "string" },
        "customPrintText": { "type": "string" },
        "standardPrice": { "type": "number" },
        "offeredPrice": { "type": "number" },
        "finalAgreedPrice": { "type": "number" },
        "notes": { "type": "string" },
        "adminNotes": { "type": "string" },
        "status": { "type": "string", "enum": ["NEW", "CONTACTED", "QUOTED", "APPROVED", "CLOSED"] },
        "whatsappUrl": { "type": "string" },
        "whatsappReplyUrl": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User patron profile and points"
    },
    "/users/{userId}/activeRewards/{rewardId}": {
      "schema": "ActiveReward",
      "description": "Active unlocked rewards"
    },
    "/users/{userId}/loyaltyTransactions/{transactionId}": {
      "schema": "LoyaltyTransaction",
      "description": "Audit trail for points"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Placed order records"
    },
    "/inquiries/{inquiryId}": {
      "schema": "InquiryQuote",
      "description": "Unified customer inquiries, wholesale requests, custom hampers, and Bid Box bargain quotes"
    },
    "/quotes/{quoteId}": {
      "schema": "InquiryQuote",
      "description": "Custom Bid Box and celebration favor bargain quotes"
    }
  }
}
