      "parameters": {
        "jsCode": "const src = $('Pending Requests?').item.json;\nconst e = $input.first().json || {};\nlet msg = '';\nif (e.errMsg) {\n  msg = e.errMsg;\n} else if (e.error) {\n  msg = e.error.message || e.error.description || (typeof e.error === 'string' ? e.error : JSON.stringify(e.error));\n} else if (e.message) {\n  msg = e.message;\n} else {\n  msg = JSON.stringify(e).slice(0, 200);\n}\nreturn [{ json: { row_number: src.row_number, sync_error: ('WF1: ' + msg).slice(0, 500) } }];"
