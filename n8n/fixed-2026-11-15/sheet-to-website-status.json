    {
      "parameters": {
        "jsCode": "// v2: IN_PROGRESS claim skip (stale claim 10 min baad retry)\nconst rows = $input.all().map(i => i.json).filter(r => r && (r.order_id || '').toString().trim());\nconst CLAIM_MAX_MS = 10 * 60 * 1000;\nconst now = Date.now();\nconst pending = rows.filter(r => {\n  const reqId = (r.request_id || '').toString().trim();\n  if (!reqId) return false;\n  const applied = (r.last_applied_request_id || '').toString().trim();\n  if (reqId === applied) return false;\n  const se = (r.sync_error || '').toString().trim();\n  if (se.indexOf('WF1: IN_PROGRESS') === 0) {\n    const m = se.match(/@(\\S+)/);\n    const claimed = m ? Date.parse(m[1]) : NaN;\n    if (!Number.isFinite(claimed) || (now - claimed) < CLAIM_MAX_MS) return false;\n  }\n  const hasStatus = (r.requested_status || '').toString().trim();\n  const hasTracking = (r.requested_tracking_number || '').toString().trim();\n  const hasEta = (r.requested_estimated_delivery || '').toString().trim();\n  const hasReason = (r.request_reason || '').toString().trim();\n  return !!hasStatus;\n});\nif (!pending.length) return [];\nreturn pending.map(r => ({ json: r }));"
      },
