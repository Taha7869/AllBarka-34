      ],
      "parameters": {
        "jsCode": "const raw = $input.first().json || {}; const body = raw.body && typeof raw.body === 'object' ? raw.body : raw;\nif(raw.statusCode!==200||body.ok!==true)throw new Error('PROVIDER_RESULT_RECONCILIATION_REQUIRED');return [{json:{ok:true,state:body.state}}];"
      }
    }
