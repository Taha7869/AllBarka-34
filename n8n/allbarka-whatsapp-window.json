{
  "name": "AllBarka verified Meta window and transactional notifications — INACTIVE",
  "active": false,
  "nodes": [
    {
      "id": "aab6a9f6e09724c1df185991595e64fc",
      "name": "Raw Verified Parent Envelope",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        500
      ],
      "parameters": {
        "inputSource": "jsonExample",
        "jsonExample": "{\"rawMetaBody\":\"EXACT_ORIGINAL_REQUEST_BODY_BYTES\",\"metaSignature\":\"sha256=ORIGINAL_X_HUB_SIGNATURE_256\"}"
      },
      "notesInFlow": true,
      "notes": "Call only from actual Meta parent. Pass unmodified raw body and original X-Hub-Signature-256. Parent is absent from supplied package; NOT verified. Never reconstruct JSON."
    },
    {
      "id": "e9dcabd091f9dd6aec242ec77d218643",
      "name": "Validate Raw Parent Envelope",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        500
      ],
      "parameters": {
        "jsCode": "const body=$input.first().json||{};if(typeof body.rawMetaBody!=='string'||!body.rawMetaBody||new TextEncoder().encode(body.rawMetaBody).byteLength>96*1024||typeof body.metaSignature!=='string'||!/^sha256=[a-f0-9]{64}$/.test(body.metaSignature))throw new Error('RAW_META_EVIDENCE_REQUIRED');return [{json:{source:'meta_parent',rawMetaBody:body.rawMetaBody,metaSignature:body.metaSignature}}];"
      }
    },
    {
      "id": "093300c809c3b126f2dd41a13b41a8f3",
      "name": "Verify Meta Evidence In Commerce",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        500
      ],
      "retryOnFail": false,
      "maxTries": 1,
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ALLBARKA_COMMERCE_ORIGIN + '/api/integrations/n8n/whatsapp/inbound' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "notesInFlow": true,
      "notes": "REQUIRED private Header Auth credential: X-AllBarka-Integration-Secret. No retries."
    },
    {
      "id": "c6c4f524e81821f7deba29da75d960ef",
      "name": "Verify Inbound Acknowledgement",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        500
      ],
      "parameters": {
        "jsCode": "const raw = $input.first().json || {}; const body = raw.body && typeof raw.body === 'object' ? raw.body : raw;\nif(raw.statusCode!==200||body.ok!==true)throw new Error('META_INGRESS_NOT_AUTHENTICATED');return [{json:{ok:true,processed:body.processed,duplicates:body.duplicates,receiptsQueued:body.receiptsQueued}}];"
      }
    },
    {
      "id": "57904d752872262a1299ac83a44e177e",
      "name": "Poll Durable Transactional Notifications",
      "type": "n8n-nodes-base.scheduleTrigger",
