        "url": "={{ $env.ALLBARKA_COMMERCE_ORIGIN + '/api/integrations/n8n/whatsapp/notifications/claim' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({source:'meta_parent'}) }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "notesInFlow": true,
      "notes": "REQUIRED private Header Auth credential: X-AllBarka-Integration-Secret. No retries."
    },
    {
      "id": "32062f5b6865e3c90699ac84cb508e6d",
      "name": "Validate Notification Lease",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "jsCode": "const raw = $input.first().json || {}; const body = raw.body && typeof raw.body === 'object' ? raw.body : raw;\nif(raw.statusCode!==200||body.ok!==true)throw new Error('NOTIFICATION_CLAIM_UNAVAILABLE');if(body.idle===true)return [];if(typeof body.jobId!=='string'||typeof body.leaseToken!=='string'||!Number.isFinite(body.leaseExpiresAtMs)||body.leaseExpiresAtMs<=Date.now())throw new Error('INVALID_NOTIFICATION_LEASE');return [{json:{source:'meta_parent',jobId:body.jobId,leaseToken:body.leaseToken}}];"
      }
    },
    {
      "id": "662b2eeddfbf83e41f9f9de755bbe31f",
      "name": "Authorize Immediately Before Send",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        0
      ],
      "retryOnFail": false,
      "maxTries": 1,
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ALLBARKA_COMMERCE_ORIGIN + '/api/integrations/n8n/whatsapp/notifications/authorize' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "notesInFlow": true,
      "notes": "REQUIRED private Header Auth credential: X-AllBarka-Integration-Secret. No retries."
    },
    {
      "id": "66200898334bdbd3730a248f45ae6cfb",
      "name": "Validate Final Window And Ownership Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        0
      ],
      "parameters": {
        "jsCode": "const raw = $input.first().json || {}; const body = raw.body && typeof raw.body === 'object' ? raw.body : raw;\nconst claim=$('Validate Notification Lease').item.json;if(raw.statusCode!==200||body.ok!==true)return [];if(body.jobId!==claim.jobId||body.leaseToken!==claim.leaseToken||!/^\\d{10,15}$/.test(body.to)||typeof body.text!=='string'||!body.text.trim()||body.text.length>4000||typeof body.eventId!=='string'||!(typeof body.revision==='string' && Number.isFinite(Date.parse(body.revision)) || body.revision===null && body.eventId.startsWith('receipt:'))||!Number.isFinite(body.sendBeforeMs)||body.sendBeforeMs<=Date.now()+6000)throw new Error('FINAL_SEND_AUTHORIZATION_INVALID');return [{json:{...claim,to:body.to,text:body.text,eventId:body.eventId,revision:body.revision,sendBeforeMs:body.sendBeforeMs}}];"
      }
    },
    {
      "id": "486d58b5422add0df4e5cb0b50a5c809",
      "name": "One Meta Service Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        0
      ],
      "retryOnFail": false,
      "maxTries": 1,
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://graph.facebook.com/' + $env.WHATSAPP_GRAPH_VERSION + '/' + $env.WHATSAPP_BUSINESS_PHONE_ID + '/messages' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({messaging_product:'whatsapp',to:$json.to,type:'text',text:{preview_url:false,body:$json.text}}) }}",
        "options": {
          "timeout": 5000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "notesInFlow": true,
      "notes": "REQUIRED existing private Meta Header Auth credential (Authorization Bearer). Exactly ONE attempt. Delivery is not claimed by HTTP acceptance. UNKNOWN requires reconciliation; never automatic resend."
    },
    {
      "id": "d166f75e02296f9ef09077d7fa4a965d",
      "name": "Classify Actual Provider Outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "jsCode": "const raw = $input.first().json || {}; const body = raw.body && typeof raw.body === 'object' ? raw.body : raw;\nconst send=$('Validate Final Window And Ownership Gate').item.json;const providerId=body.messages?.[0]?.id;const accepted=raw.statusCode>=200&&raw.statusCode<300&&typeof providerId==='string'&&providerId.length>0&&providerId.length<=255;const rejected=raw.statusCode>=400&&raw.statusCode<500&&raw.statusCode!==408&&raw.statusCode!==429&&body.error;return [{json:{source:'meta_parent',jobId:send.jobId,leaseToken:send.leaseToken,outcome:accepted?'ACCEPTED':rejected?'REJECTED':'UNKNOWN',...(accepted?{providerMessageId:providerId}:{})}}];"
      }
    },
