      "name": "Claim One Durable Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        200,
        0
      ],
      "retryOnFail": false,
      "maxTries": 1,
      "onError": "continueRegularOutput",
      "parameters": {
