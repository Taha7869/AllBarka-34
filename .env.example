# Public Firebase Web app configuration: actual identifiers from Firebase Project Settings.
# These values reach browser assets; never put Admin/Groq/webhook secrets under VITE_.
VITE_FIREBASE_PROJECT_ID=allbarka-live
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=allbarka-live.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=allbarka-live.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIRESTORE_DATABASE_ID=(default)

# Static Azure/Netlify frontend requires an actual HTTPS Express API origin, without /api.
# Blank retains same-origin fullstack behavior only when Express serves the website.
VITE_API_BASE_URL=

# Server runtime: private host settings, never frontend/static build configuration.
NODE_ENV=production
PORT=3000
APP_URL=
# Comma-separated exact HTTPS frontend origins, without path/wildcard.
FRONTEND_ORIGINS=
# Set to the actual trusted ingress hop count; do not infer from the host name.
TRUST_PROXY_HOPS=0

# Firebase Admin: production Firestore order persistence and token verification.
FIREBASE_PROJECT_ID=allbarka-live
FIREBASE_CLIENT_EMAIL=
# Supply actual service-account key securely on the server; escaped newline form is supported.
FIREBASE_PRIVATE_KEY=
FIRESTORE_DATABASE_ID=(default)
ADMIN_UID=

# Guest AI quota fingerprinting: a distinct random 32+ character server secret.
AI_GUEST_HASH_SECRET=

# Website AI -> private current n8n/Groq workflow.
# Production URL: https://<actual-n8n-host>/webhook/allbarka-website-ai
# Header Auth name X-AllBarka-Webhook-Secret; no Groq key is stored in this repo.
N8N_AI_WEBHOOK_URL=
N8N_AI_WEBHOOK_SECRET=
# n8n20s < API22s < browser30s; API value bounded1000–22000.
N8N_AI_TIMEOUT_MS=22000

# Durable ORDER_CREATED outbox -> existing Order_Control Sheet through n8n.
# Production URL: https://<actual-n8n-host>/webhook/allbarka-website-orders
# Separate random32+ secret. TLS + Header Auth; receiver does not verify HMAC.
# Both URL/secret must be valid to enable new events. Historical DISABLED events never replay.
N8N_ORDER_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Full acknowledgement deadline, including body parsing; bounded1000–30000.
N8N_ORDER_TIMEOUT_MS=5000
# Worker policy is fixed:1000ms poll,6 attempts,30s exponential backoff capped15min,
# global/event lease>=60s,serialized delivery. Long-running Express+Firestore required.
# No environment switch reactivates historical DISABLED/failed events.

# Separate revision-aware status mirror; never use the ORDER_CREATED receiver here.
N8N_STATUS_WEBHOOK_URL=
N8N_STATUS_WEBHOOK_SECRET=
N8N_STATUS_TIMEOUT_MS=5000

# Private n8n -> commerce status/receipt/window routes. Distinct random32+ secret.
N8N_INTEGRATION_SECRET=
# Original Meta webhook signature verification on the backend; never client/profile phone assertions.
WHATSAPP_META_APP_SECRET=
WHATSAPP_BUSINESS_PHONE_ID=
# Remains false until the actual existing Meta parent, original bytes and business phone are inspected.
WHATSAPP_PARENT_VERIFIED=false

# Optional legacy existing services. Current n8n Groq key stays in its n8n credential.
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
