# Server-only Firebase Admin Configuration (Required for Production Firestore Order Persistence)
# Targets production project 'AllBarka-Live' (Project ID: allbarka-live, Database: (default))
# Do NOT prefix with VITE_ to keep credentials strictly server-side.
FIREBASE_PROJECT_ID=allbarka-live
FIREBASE_CLIENT_EMAIL=your_firebase_admin_client_email
FIREBASE_PRIVATE_KEY="your_firebase_admin_private_key"
FIRESTORE_DATABASE_ID=(default)

# Client-side Firebase Web App Configuration (Referenced by src/lib/firebase.ts)
VITE_FIREBASE_PROJECT_ID=allbarka-live
VITE_FIREBASE_APP_ID=your_vite_firebase_app_id
VITE_FIREBASE_API_KEY=your_vite_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=allbarka-live.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=allbarka-live.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_vite_firebase_messaging_sender_id
VITE_FIREBASE_MEASUREMENT_ID=your_vite_firebase_measurement_id
VITE_FIRESTORE_DATABASE_ID=(default)

# Server-only n8n Order Notification Webhook Configuration (Optional / Multi-channel Dispatch)
# Safe, isolated order event dispatching. If unconfigured, server gracefully operates without error.
N8N_ORDER_WEBHOOK_URL=https://your-n8n-instance.com/webhook/allbarka-orders
N8N_WEBHOOK_SECRET=your_optional_n8n_hmac_secret_key

# Server-only AI & External Services
GEMINI_API_KEY=your_gemini_api_key
APP_URL=https://your-app-url.onrender.com
PORT=3000

# Google Sheets Integration (Optional Backend Backup)
GOOGLE_SHEETS_ID=your_google_sheets_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_google_service_account_email
GOOGLE_PRIVATE_KEY="your_google_private_key"

# AI Consultant (server only). Use a random 32+ character secret.
AI_GUEST_HASH_SECRET=
# Set to 1 only if the HTTPS API is behind one trusted reverse proxy.
TRUST_PROXY_HOPS=0
# Optional n8n workflow on AWS. The workflow calls Ollama through its own tunnel.
# If omitted, the existing Gemini / boutique response path remains active.
N8N_AI_WEBHOOK_URL=
N8N_AI_WEBHOOK_SECRET=
