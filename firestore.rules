rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to verify authenticated owner
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper to verify authenticated store administrator
    function isAdmin() {
      return request.auth != null && (request.auth.token.admin == true || request.auth.token.role == 'admin');
    }

    // Validate only contact fields. Existing server-managed membership/loyalty fields
    // can remain on a profile, but no browser operation may add or change them.
    function validContactFields(data) {
      return (!('name' in data) || (data.name is string && data.name.size() <= 120))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('address' in data) || (data.address is string && data.address.size() <= 1000))
        && (!('city' in data) || (data.city is string && data.city.size() <= 120))
        && (!('createdAt' in data) || data.createdAt is number)
        && (!('updatedAt' in data) || data.updatedAt is number);
    }

    // User profile: only safe customer contact fields editable by client
    match /users/{userId} {
      allow read: if isOwner(userId);
      
      allow create: if isOwner(userId) 
        && request.resource.data.keys().hasOnly(['name', 'phone', 'address', 'city', 'createdAt', 'updatedAt'])
        && validContactFields(request.resource.data);
        
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'address', 'city', 'updatedAt'])
        && validContactFields(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['loyaltyPoints', 'role', 'admin', 'wholesaleEligible', 'patronStatus', 'tier']));
        
      allow delete: if false;

      // Loyalty transactions and active rewards: read-only for patron; writes restricted strictly to server
      match /loyaltyTransactions/{txId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /activeRewards/{rewardId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Customer favorites and saved bag: client writable for owner
      match /favorites/{favId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Canonical orders contain private staff notes, identifiers and claim credentials.
    // Customer reads use the authenticated, sanitized /api/me/orders and order API.
    // Firebase Admin on the server bypasses these browser rules.
    match /orders/{orderId} {
      allow read, write: if false;
    }

    // Coupons and discounts: server-side evaluation only
    match /coupons/{couponId} {
      allow read, write: if false;
    }

    // Products collection contains sensitive supplier costs, reference prices,
    // draft/archived status, and internal margin notes. Public storefront consumes
    // the sanitized, active-only /api/catalog and /api/catalog/products/:id endpoints.
    // Direct client reads are restricted strictly to store administrators.
    match /products/{productId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if false;
    }

    match /content/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Customer inquiries and custom Bid Box / wholesale quotes:
    // Written and managed via backend API (/api/inquiries, /api/quotes, /api/admin/inquiries);
    // authenticated admins may also read/write directly.
    match /inquiries/{inquiryId} {
      allow read, write: if isAdmin();
    }

    match /quotes/{quoteId} {
      allow read, write: if isAdmin();
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
